# Copy to `.env` and fill in. The .env file MUST NOT be committed.
# A new master key is generated automatically on first run if FPK_SECRET_KEY is unset
# (it gets persisted to data/.master.key with mode 0600). Set this explicitly to share
# the same encrypted database between machines / backups.

# Hex-encoded 32-byte key (64 hex chars). Generate with: python -c "import secrets;print(secrets.token_hex(32))"
FPK_SECRET_KEY=

# Bind address (DO NOT change to 0.0.0.0 unless you understand the risks).
FPK_HOST=127.0.0.1
FPK_PORT=8000

# Allowed origin for the local UI (used for CORS + Origin header check).
FPK_ALLOWED_ORIGIN=http://127.0.0.1:8000

# Set to "production" to enable Secure cookies and stricter logging.
FPK_ENV=development
